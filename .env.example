# ---- docker compose settings (copy to .env) ----
MYSQL_DATABASE=silkgrade
MYSQL_USER=silkgrade
MYSQL_PASSWORD=silkgrade
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306

# use long random strings in production (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
FILE_URL_SECRET=change-me-file-secret-0123456789abcdef
ENGINE_INTERNAL_TOKEN=change-me-engine-token

WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
LAB_NAME=Bangalore Silk Board — Silk Testing Laboratory
SEED_ADMIN_EMAIL=admin@silkgrade.local
SEED_ADMIN_PASSWORD=Admin@12345
