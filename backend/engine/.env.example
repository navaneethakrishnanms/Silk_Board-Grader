# engine-svc settings (copy to .env)
# Absolute path of the storage folder shared with the API (originals, derived, reports)
STORAGE_ROOT=../../storage
ENGINE_DERIVED_DIR=derived
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8001
ENGINE_LOG_LEVEL=info
# Shared secret the API sends in the X-Engine-Token header (empty = disabled)
ENGINE_INTERNAL_TOKEN=change-me-engine-token
