# ---- SilkGrade API (copy to .env) ----
NODE_ENV=development
PORT=4000
# Public base path of the API
API_PREFIX=/api/v1

# MySQL 8 (Prisma). Local docker: docker compose up -d mysql
DATABASE_URL=mysql://silkgrade:silkgrade@localhost:3306/silkgrade

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Signed file URLs (images, heat-maps, PDFs)
FILE_URL_SECRET=dev-file-secret-change-me-0123456789
FILE_URL_TTL_SECONDS=3600

# CORS whitelist (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage folder shared with engine-svc (relative paths resolve against backend/api)
STORAGE_ROOT=../../storage
MAX_UPLOAD_MB=40

# Internal engine service
ENGINE_URL=http://127.0.0.1:8001
ENGINE_INTERNAL_TOKEN=change-me-engine-token
ENGINE_TIMEOUT_MS=60000

# Lab branding (also editable in Settings)
LAB_NAME=Bangalore Silk Board — Silk Testing Laboratory

# Seed
SEED_ADMIN_EMAIL=admin@silkgrade.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true
