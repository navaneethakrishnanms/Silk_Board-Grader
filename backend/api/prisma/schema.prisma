// SilkGrade — MySQL 8 schema (Section 5 of the build prompt).
// Additions to the spec (marked "+") support the workflow: image side/preview,
// grading error for job retry, void reason, report path, manual alignment points.
// Rules: grades are never updated after creation (an override adds an
// ExpertGrade); images are never overwritten; AuditLog is insert-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TESTER
  EXPERT
  ADMIN
}

enum TestStatus {
  DRAFT
  PENDING_WASH
  READY_TO_GRADE
  GRADING
  GRADED_AUTO
  NEEDS_REVIEW
  COMPLETED
  VOID
}

enum ImageRole {
  SPECIMEN_BEFORE
  SPECIMEN_AFTER
  ADJ1_BEFORE
  ADJ1_AFTER
  ADJ2_BEFORE
  ADJ2_AFTER
  COMPOSITE_BEFORE
  COMPOSITE_AFTER
  REF_CARD
}

enum Piece {
  SPECIMEN
  ADJ1
  ADJ2
  REF_CARD
}

enum GradeKind {
  CHANGE_OVERALL
  CHANGE_GROUND
  CHANGE_MOTIF
  CHANGE_WORST
  STAIN_ADJ1
  STAIN_ADJ2
  STAIN_WORST
}

enum Decision {
  AUTO
  REVIEW
}

enum FabricType {
  PLAIN
  PRINTED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  tests        Test[]        @relation("TestCreatedBy")
  expertGrades ExpertGrade[]
}

model Sample {
  id           String     @id // e.g. BSB-2026-00123
  batchId      String?
  customer     String?
  fibre        String     @default("silk")
  construction String? // satin, crepe, georgette, plain weave
  fabricType   FabricType
  baseShade    String? // light | medium | dark
  dominantHue  String?
  dyeClass     String?
  notes        String?    @db.Text
  tests        Test[]

  @@index([batchId])
  @@index([customer])
}

model Test {
  id             String     @id @default(uuid())
  reportNo       String     @unique // SG-2026-000123
  sampleId       String
  sample         Sample     @relation(fields: [sampleId], references: [id])
  washMethod     String // e.g. ISO 105-C10 A
  washTempC      Float?
  washTimeMin    Float?
  adjCount       Int        @default(2)
  adj1Fibre      String     @default("silk")
  adj2Fibre      String?    @default("cotton")
  reqGradeChange Float? // e.g. 4.0
  reqGradeStain  Float? // e.g. 3.5
  status         TestStatus @default(DRAFT)
  datasetMode    Boolean    @default(false)
  captureDevice  String?
  uploadMode     String     @default("separate") // + separate | single
  createdById    String
  createdBy      User       @relation("TestCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
  gradingError   String?    @db.Text // + last failed grading job
  engineResult   Json? // + global warnings, registration, versions of the last grading run
  manualPoints   Json? // + {before:[[x,y],[x,y]], after:[...]} manual alignment
  voidReason     String?    @db.Text // +
  reportPath     String? // + generated PDF (storage-relative)
  images         Image[]
  grades         Grade[]

  @@index([status])
  @@index([sampleId])
  @@index([createdAt])
}

model Image {
  id          String    @id @default(uuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id])
  role        ImageRole
  side        String? // + before | after (REF_CARD needs it)
  path        String // storage-relative, original file — never modified
  previewPath String? // + browser-displayable JPEG generated by the engine
  fileName    String? // +
  sizeBytes   Int? // +
  sha256      String
  width       Int
  height      Int
  device      String? // from EXIF
  warnings    Json // {blur, clipping, glare, lowRes, noRefCard}
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  regions     Region[]

  @@index([testId])
}

model Region {
  id           String   @id @default(uuid())
  imageId      String
  image        Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  piece        Piece
  polygon      Json // [[x,y],...] in image pixels
  maskPath     String?
  autoDetected Boolean  @default(true)
  editedBy     String?
  stats        Json? // median L,a,b; area; valid pixel share
  createdAt    DateTime @default(now()) // +

  @@index([imageId])
}

model Grade {
  id            String        @id @default(uuid())
  testId        String
  test          Test          @relation(fields: [testId], references: [id])
  kind          GradeKind
  label         String? // e.g. "motif 1 (teal)"
  isoRating     Float
  modelRating   Float? // null in formula-only mode
  finalRating   Float
  halfGrade     Float // 1.0 … 5.0 step 0.5
  ciLow         Float
  ciHigh        Float
  confidence    String // HIGH | MEDIUM | LOW
  decision      Decision
  pass          Boolean?
  features      Json // dE, dE00, dL, dC, dH, p10, p50, p90, areaShare ...
  heatmapPath   String?
  engineVersion String
  modelVersion  String // "formula-only" until trained
  createdAt     DateTime      @default(now())
  expertGrades  ExpertGrade[]

  @@index([testId])
}

model ExpertGrade {
  id        String   @id @default(uuid())
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  halfGrade Float
  reason    String?  @db.Text
  blind     Boolean  @default(false) // true in dataset mode
  createdAt DateTime @default(now())

  @@index([gradeId])
}

model ModelVersion {
  id        String   @id @default(uuid())
  name      String // m1_change, m2_stain
  version   String
  path      String
  sha256    String
  metrics   Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([name, version])
}

model Setting {
  key   String @id // required grade presets, thresholds ...
  value Json
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  action    String // CREATE_TEST, UPLOAD, GRADE, OVERRIDE, EXPORT ...
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
